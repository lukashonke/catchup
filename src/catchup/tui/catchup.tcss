Screen {
    background: $background;
    color: $foreground;
}

#bar {
    height: 2;
    padding: 1 2 0 2;
}

#summary {
    width: 1fr;
}

#last-run {
    width: auto;
    color: $dim;
}

#tabs {
    padding: 1 2 0 1;
    border-bottom: solid $line;
    height: 3;
}

#filter-bar {
    display: none;
    height: 2;
    padding: 1 2 0 2;
    & > #filter-label {
        width: auto;
        margin-right: 1;
        color: $dim;
    }
    & > #filter {
        height: 1;
        border: none;
        padding: 0 1;
        background: $button;
        &:focus {
            background: $selected;
        }
    }
}

#panes, #t-panes {
    height: 1fr;
}

#list, #t-list {
    width: 1fr;
    height: 1fr;
    max-height: 100%;
    border: none;
    padding: 1 1 0 1;
    background: $background;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $line;
    & > .option-list--option {
        padding: 0 1;
    }
    & > .option-list--option-highlighted,
    &:focus > .option-list--option-highlighted {
        color: $foreground;
        background: $selected;
        text-style: none;
    }
    & > .option-list--option-hover {
        background: $hover;
    }
    & > .option-list--option-disabled {
        color: $faint;
    }
    &:focus {
        background-tint: transparent;
    }
}

#details, #t-details {
    width: 1fr;
    min-width: 62;
    height: 1fr;
    border-left: solid $line;
    padding: 1 2;
    scrollbar-size-vertical: 1;
    scrollbar-background: $background;
    scrollbar-color: $line;
    & > * {
        height: auto;
    }
    & > #d-empty, & > #t-empty {
        display: none;
        color: $faint;
    }
    & > .-hidden, &.-empty > * {
        display: none;
    }
    &.-empty > #d-empty, &.-empty > #t-empty {
        display: block;
    }
}

#d-title, #t-title {
    color: $bright;
    text-style: bold;
}

#d-meta {
    color: $dim;
    margin-bottom: 1;
}

#t-meta {
    color: $dim;
}

#d-body, #t-body {
    margin: 0;
    padding: 0;
    background: $background;
    & MarkdownParagraph {
        margin: 0 0 1 0;
    }
}

#d-links, #t-link, #t-due {
    margin-bottom: 1;
}

#d-actions {
    height: auto;
    margin-bottom: 1;
    & > Horizontal {
        width: auto;
        height: auto;
    }
    & Button {
        margin-right: 1;
        min-width: 0;
        width: auto;
        padding: 0;
        background: $button;
        color: $foreground;
        text-style: none;
        &:hover {
            background: $selected;
        }
        &.primary {
            background: $accent;
            color: $ink;
            text-style: bold;
        }
        &.small {
            color: $dim;
        }
    }
    & #snooze-label {
        color: $dim;
        margin-right: 1;
    }
}

.label {
    color: $faint;
    text-style: bold;
}

#d-prompt {
    color: $dim;
    border-left: solid $line;
    padding-left: 1;
    margin-bottom: 1;
}

/* The Todoist tab takes the place of the panes while it is shown. */
#todoist-view {
    display: none;
    height: 1fr;
}

#t-status {
    height: 2;
    padding: 1 2 0 2;
    color: $dim;
}

#t-setup {
    max-width: 90;
    padding: 1 2;
}

#footer {
    height: 1;
    padding: 0 2;
    background: $chrome;
    color: $dim;
    & > #footer-keys {
        width: 1fr;
    }
    & > #footer-help {
        width: auto;
    }
}

/* Below NARROW_COLUMNS the details pane moves below the list. */
Screen.-narrow, Screen.-tiny {
    & #panes, & #t-panes {
        layout: vertical;
    }
    & #list, & #t-list {
        width: 1fr;
        height: auto;
        max-height: 45%;
        /* All four sides: Textual applies a lone padding-bottom as the whole padding. */
        padding: 1 1 1 1;
    }
    & #details, & #t-details {
        width: 1fr;
        min-width: 0;
        border-left: none;
        border-top: solid $line;
    }
}

Toast {
    background: $button;
    padding: 0 1;
    &.-information {
        border-left: outer $accent;
        & .toast--title {
            color: $accent;
        }
    }
    &.-error {
        border-left: outer $error;
        & .toast--title {
            color: $error;
        }
    }
}

/* Below TINY_COLUMNS the snooze and ignore buttons wrap to a second line. */
Screen.-tiny #d-actions {
    layout: vertical;
}

Settings {
    align: center middle;
    background: $chrome 60%;
}

#settings {
    width: 90;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    background: $panel;
    border: solid $line;
    scrollbar-size-vertical: 1;
    scrollbar-background: $panel;
    scrollbar-color: $line;
    & > #s-title {
        color: $bright;
        text-style: bold;
    }
    & > #s-path, & > .s-hint, & > #s-keys {
        color: $dim;
    }
    & > .s-label {
        color: $faint;
        text-style: bold;
        margin-top: 1;
    }
    & > Input {
        border: none;
        height: 1;
        padding: 0 1;
        background: $button;
        &:focus {
            background: $selected;
        }
    }
    & > Checkbox {
        background: $panel;
        color: $foreground;
        &:focus {
            background: $selected;
        }
    }
    & > TextArea {
        border: none;
        height: 6;
        padding: 0 1;
        background: $button;
        &:focus {
            background: $selected;
        }
    }
    & > #agent_log {
        height: 12;
        background: $chrome;
        color: $dim;
        &:focus {
            background: $chrome;
        }
    }
    & > #s-actions {
        height: auto;
        margin-top: 1;
        & Button {
            margin-right: 1;
            min-width: 0;
            width: auto;
            padding: 0;
            background: $button;
            color: $foreground;
            text-style: none;
            &.primary {
                background: $accent;
                color: $ink;
                text-style: bold;
            }
        }
    }
}

SnoozePicker, NoteEditor, KeysHelp {
    align: center middle;
    background: $chrome 60%;
}

.dialog {
    width: 60;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    background: $panel;
    border: solid $line;
    & > .dialog-title {
        color: $bright;
        text-style: bold;
    }
    & > .dialog-hint, & > .dialog-keys {
        color: $dim;
    }
    & > .dialog-keys, & > #keys {
        margin-top: 1;
    }
    & > OptionList {
        height: auto;
        margin-top: 1;
        border: none;
        padding: 0;
        background: $panel;
        & > .option-list--option {
            padding: 0 1;
        }
        & > .option-list--option-highlighted,
        &:focus > .option-list--option-highlighted {
            color: $foreground;
            background: $selected;
            text-style: none;
        }
        & > .option-list--option-hover {
            background: $hover;
        }
        &:focus {
            background-tint: transparent;
        }
    }
    & > Input, & > TextArea {
        margin-top: 1;
        border: none;
        height: 1;
        padding: 0 1;
        background: $button;
        &:focus {
            background: $selected;
        }
    }
    & > TextArea {
        height: 8;
    }
}

ContextView {
    background: $background;
    & > #context {
        padding: 1 2;
        scrollbar-size-vertical: 1;
        scrollbar-color: $line;
        & > #c-title {
            color: $bright;
            text-style: bold;
        }
        & > #c-meta {
            color: $dim;
            margin-bottom: 1;
        }
        & > #c-title, & > #c-meta, & > #c-body, & > #c-error {
            /* Long lines are hard to read on a wide terminal. */
            max-width: 100;
        }
        & > #c-body {
            margin: 0;
            padding: 0;
            background: $background;
            & MarkdownParagraph {
                margin: 0 0 1 0;
            }
            & MarkdownHeader {
                margin: 1 0 1 0;
                color: $bright;
            }
            & > MarkdownHeader:first-child {
                margin-top: 0;
            }
        }
    }
    & > #c-keys {
        dock: bottom;
        height: 1;
        padding: 0 2;
        background: $chrome;
        color: $dim;
    }
}
